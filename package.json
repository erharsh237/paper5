{
  "name": "sprint-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "console": "vite owner-console --config owner-console/vite.config.js",
    "console:build": "vite build owner-console --config owner-console/vite.config.js",
    "video:export": "node .agents/skills/paper5-video-production/scripts/render.mjs --aspect portrait --fps 60",
    "video:preview": "node .agents/skills/paper5-video-production/scripts/render.mjs --aspect portrait --fps 60 --preview",
    "video:landscape": "node .agents/skills/paper5-video-production/scripts/render.mjs --aspect landscape --fps 60",
    "video:square": "node .agents/skills/paper5-video-production/scripts/render.mjs --preset square",
    "video:reel": "node .agents/skills/paper5-video-production/scripts/render.mjs --preset reel",
    "video:youtube": "node .agents/skills/paper5-video-production/scripts/render.mjs --preset youtube",
    "video:test": "node .agents/skills/paper5-video-production/scripts/render.mjs --preset reel --duration 5 --out exports/test-5s.mp4",
    "video:launch": "node .agents/skills/paper5-video-production/scripts/render.mjs --preset reel --out exports/paper5-instagram-launch.mp4"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/react": "^10.69.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "ldrs": "^1.1.9",
    "lenis": "^1.3.27",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.7.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.5"
  }
