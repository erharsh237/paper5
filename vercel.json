{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.paper5.co"
        }
      ],
      "destination": "https://paper5.co/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(pricing|features|about|about-us|contact|product-integrations|changelog|docs|docs/api|security|legal|legal/terms|legal/privacy|legal/dpa|legal/subprocessors|terms|privacy|dpa|subprocessors|thank-you|error|login|signup|forgot-password|verify|join|workspace|auth/action|reset-password)",
      "destination": "/index.html"
    },
    {
      "source": "/:workspaceId",
      "has": [
        {
          "type": "host",
          "value": "^(app\\.paper5\\.co|.*\\.vercel\\.app)$"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/:workspaceId/(workflow|team|meeting|analytics|integrations|settings|profile)",
      "has": [
        {
          "type": "host",
          "value": "^(app\\.paper5\\.co|.*\\.vercel\\.app)$"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|logo\\.png|og-image\\.png|favicon\\.ico|favicon\\.svg|dashboard-mockup\\.jpg|product-film\\.html|sprintos_dashboard\\.html|llms\\.txt|robots\\.txt|sitemap\\.xml|\\.well-known(?:/.*)?|\\.dev\\.vars|wrangler\\.(?:toml|json|jsonc)|vercel\\.json|\\.vercel(?:/.*)?|\\.env(?:\\..*)?|\\.git(?:/.*)?).*)",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://challenges.cloudflare.com https://va.vercel-scripts.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.emailjs.com https://*.sentry.io https://challenges.cloudflare.com https://va.vercel-scripts.com https://vitals.vercel-insights.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; upgrade-insecure-requests;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/mta-sts.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
