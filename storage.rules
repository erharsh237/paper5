rules_version = '2';

// Cross-service rule: checks the same allowedUsers Firestore collection the
// app's Firestore rules use, so Storage access is gated by the same
// allowlist rather than "any signed-in Google account."
service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedUser() {
      return request.auth != null && request.auth.token.email != null &&
        firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // profile-pics/{email}/{filename} and resumes/{email}/{filename} —
    // team can view everyone's (small trusted crew), but each person can
    // only write into their own email-prefixed folder.
    //
    // Content-type is an explicit allowlist, not a wildcard: image/.*
    // previously accepted image/svg+xml, and SVGs can carry embedded
    // <script> content — safe as rendered via <img> but not if that URL
    // is ever opened directly or embedded differently. Resumes previously
    // had no server-side type check at all — the client-side PDF/Word
    // restriction was advisory only and trivially bypassed by anyone
    // calling the upload function directly with a different file type
    // (e.g. .html), which the browser could then render if the link was
    // opened.
    match /profile-pics/{userEmail}/{fileName} {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser()
        && userEmail == request.auth.token.email.lower()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /resumes/{userEmail}/{fileName} {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser()
        && userEmail == request.auth.token.email.lower()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    // Everything else stays closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
